{
  "hosting": {
    "site": "tementrip-app",
    "public": "build/web",
    "ignore": ["firebase.json", "**/.last_build_id", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**/*.@(html|js|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
