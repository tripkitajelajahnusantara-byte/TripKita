APP_ENV="production"
PORT="8080"

# Gunakan DATABASE_URL, atau lengkapi seluruh DB_* di bawah.
DATABASE_URL=""
DB_HOST="your-postgres-host"
DB_NAME="postgres"
DB_PASSWORD="your-db-password"
DB_PORT="5432"
DB_SSLMODE="require"
DB_USER="your-db-user"

# Ukuran connection pool. Sesuaikan dengan batas koneksi penyedia database dibagi
# jumlah replica aplikasi; DB_MAX_IDLE_CONNS tidak boleh melebihi DB_MAX_OPEN_CONNS.
DB_MAX_OPEN_CONNS="25"
DB_MAX_IDLE_CONNS="10"

JWT_SECRET="replace-with-at-least-32-random-characters"
FRONTEND_URL="https://your-frontend.example.com"
BACKEND_URL="https://your-api.example.com"
ALLOWED_ORIGINS="https://your-frontend.example.com"
# Isi CIDR reverse proxy hanya jika deployment memang melewati proxy tepercaya.
TRUSTED_PROXIES=""

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-api.example.com/api/v1/public/auth/google/callback"

XENDIT_SECRET_KEY="xnd_production_your_secret_key"
XENDIT_WEBHOOK_TOKEN="replace-with-xendit-callback-verification-token"

# Pencairan otomatis ke rekening mitra melalui Xendit Payouts API.
# JANGAN diaktifkan sebelum saldo Xendit disiapkan dan rekonsiliasi saldo bersih:
# saat aktif, persetujuan admin langsung memindahkan uang sungguhan.
# Biarkan false untuk tetap memakai transfer manual oleh admin.
ENABLE_AUTOMATIC_PAYOUT="false"
# Token callback untuk webhook status pencairan. Kosongkan untuk memakai
# XENDIT_WEBHOOK_TOKEN. Wajib diisi bila ENABLE_AUTOMATIC_PAYOUT=true.
XENDIT_PAYOUT_WEBHOOK_TOKEN=""

# Aktifkan RUN_MIGRATIONS hanya saat rollout migrasi yang terkontrol.
RUN_MIGRATIONS="false"
SEED_DB="false"
ENABLE_DEV_MOCKS="false"
ENABLE_BACKGROUND_JOBS="true"

# Hanya untuk database development saat SEED_DB=true:
# DEV_ADMIN_PASSWORD="generate-a-local-password"
# DEV_PROVIDER_PASSWORD="generate-a-local-password"

# SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-16-digit-app-password"
SMTP_FROM="no-reply@your-domain.example"
