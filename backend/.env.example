APP_ENV="production"
PORT="8080"

# Gunakan DATABASE_URL, atau lengkapi seluruh DB_* di bawah.
DATABASE_URL=""
DB_HOST="your-postgres-host"
DB_NAME="postgres"
DB_PASSWORD="your-db-password"
DB_PORT="5432"
DB_SSLMODE="require"
DB_USER="your-db-user"

# Ukuran connection pool. Sesuaikan dengan batas koneksi penyedia database dibagi
# jumlah replica aplikasi; DB_MAX_IDLE_CONNS tidak boleh melebihi DB_MAX_OPEN_CONNS.
DB_MAX_OPEN_CONNS="25"
DB_MAX_IDLE_CONNS="10"

JWT_SECRET="replace-with-at-least-32-random-characters"
FRONTEND_URL="https://your-frontend.example.com"
BACKEND_URL="https://your-api.example.com"
ALLOWED_ORIGINS="https://your-frontend.example.com"
# Isi CIDR reverse proxy hanya jika deployment memang melewati proxy tepercaya.
TRUSTED_PROXIES=""

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-api.example.com/api/v1/public/auth/google/callback"

# Payment gateway iPaymu. Kredensial sandbox dan production berbeda.
IPAYMU_VA="your-ipaymu-merchant-va"
IPAYMU_API_KEY="your-ipaymu-api-key"
IPAYMU_BASE_URL="https://my.ipaymu.com/api/v2"
# Kosongkan ketiganya agar backend membuat URL per booking dari BACKEND_URL dan
# FRONTEND_URL. Isi hanya bila endpoint kustom memang diperlukan.
IPAYMU_CALLBACK_URL=""
IPAYMU_RETURN_URL=""
IPAYMU_CANCEL_URL=""

# Wajib false sampai kontrak/API pembayaran massal dua tahap iPaymu sudah
# diaktifkan pada akun merchant dan diintegrasikan. Saat false, admin melakukan
# transfer DP/pelunasan lalu mencatat hasilnya di dashboard.
ENABLE_AUTOMATIC_PAYOUT="false"

# Aktifkan RUN_MIGRATIONS hanya saat rollout migrasi yang terkontrol.
RUN_MIGRATIONS="false"
SEED_DB="false"
ENABLE_DEV_MOCKS="false"
ENABLE_BACKGROUND_JOBS="true"

# Hanya untuk database development saat SEED_DB=true:
# DEV_ADMIN_PASSWORD="generate-a-local-password"
# DEV_PROVIDER_PASSWORD="generate-a-local-password"

# SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-16-digit-app-password"
SMTP_FROM="no-reply@your-domain.example"
