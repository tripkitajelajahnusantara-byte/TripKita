# Konfigurasi STAGING untuk menguji pencairan otomatis ke mitra.
#
# Berkas ini SENGAJA berbeda dari .env.example (production): di sini
# ENABLE_AUTOMATIC_PAYOUT sudah menyala supaya integrasi payout dapat diuji.
# Jangan pernah memakai berkas ini untuk production.
#
# WAJIB memakai Development API Key Xendit (awalan xnd_development_).
# Dengan kunci itu, seluruh permintaan tidak pernah menyentuh jaringan bank.

APP_ENV="production"
PORT="8080"

# Gunakan database staging terpisah. Jangan pernah menunjuk database production:
# skrip uji membuat dan menghapus data.
DATABASE_URL=""
DB_HOST="your-staging-postgres-host"
DB_NAME="tripkita_staging"
DB_PASSWORD="your-staging-db-password"
DB_PORT="5432"
DB_SSLMODE="require"
DB_USER="your-staging-db-user"

DB_MAX_OPEN_CONNS="10"
DB_MAX_IDLE_CONNS="5"

JWT_SECRET="gunakan-secret-acak-khusus-staging-minimal-32-karakter"
FRONTEND_URL="https://staging-app.example.com"
BACKEND_URL="https://staging-api.example.com"
ALLOWED_ORIGINS="https://staging-app.example.com"
TRUSTED_PROXIES=""

GOOGLE_CLIENT_ID="staging-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="staging-google-client-secret"
GOOGLE_REDIRECT_URI="https://staging-api.example.com/api/v1/public/auth/google/callback"

# Kunci DEVELOPMENT, bukan production.
XENDIT_SECRET_KEY="xnd_development_ganti_dengan_kunci_development_anda"
XENDIT_WEBHOOK_TOKEN="token-callback-invoice-dari-dashboard-xendit"

# ==========================================================================
# Pencairan otomatis: MENYALA di staging.
#
# BACKEND_URL wajib dapat dijangkau dari internet, karena status akhir
# pencairan HANYA datang dari callback Xendit. Bila tidak terjangkau,
# pencairan akan menggantung selamanya di status PROCESSING.
#
# Daftarkan callback payout di dashboard Xendit ke:
#   https://staging-api.example.com/api/v1/public/webhooks/xendit/payout
# ==========================================================================
ENABLE_AUTOMATIC_PAYOUT="true"
XENDIT_PAYOUT_WEBHOOK_TOKEN="token-callback-payout-dari-dashboard-xendit"

RUN_MIGRATIONS="false"
SEED_DB="false"
ENABLE_DEV_MOCKS="false"
ENABLE_BACKGROUND_JOBS="true"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="staging-smtp-user"
SMTP_PASS="staging-smtp-password"
SMTP_FROM="no-reply@staging.example.com"
